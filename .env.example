# ===============================================================
# MBA Study Hub Backend — Environment Configuration Example
# Copy to .env and configure appropriately for your environment
# ===============================================================

PROJECT_NAME="MBA Study Hub Backend"
ENV=development

# Database Settings
# Local development uses SQLite:
DATABASE_URL=sqlite:///./data/mba_study_hub.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://mba_user:secure_password@localhost:5432/mba_study_hub_db

# Security & JWT Tokens
SECRET_KEY=change-this-in-production-to-a-very-long-random-secret-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage Configuration
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_BYTES=52428800

# Reminders & Notification Service Integration
# Note: Platform strictly validates delivery before marking confirmed
NOTIFICATION_ENABLED=True
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
PUSH_SERVICE_API_KEY=

# Rate Limiting
AUTH_RATE_LIMIT_PER_MINUTE=20
